{
  "info": {
    "name": "Triune Enterprise SaaS API (TES v1.0)",
    "description": "Master Postman collection for Triune Enterprise Architecture with Multi-tenancy, JWT Authentication (Cookies & Headers), and Structured Error Logging.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "accessToken", "value": "" },
    { "key": "tenantSlug", "value": "triune-demo" }
  ],
  "item": [
    {
      "name": "System Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Login (Tenant Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.tokens) {",
                  "  pm.collectionVariables.set('accessToken', res.data.tokens.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@triunedemo.com\",\n  \"password\": \"Admin@123\",\n  \"tenantSlug\": \"{{tenantSlug}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "2. Get Current Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "3. Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"<paste_refresh_token_here>\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "4. Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "1. List Users (Tenant Scoped)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/users?page=1&limit=10"
          }
        },
        {
          "name": "2. Create User in Tenant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teacher1@triunedemo.com\",\n  \"password\": \"Admin@123\",\n  \"firstName\": \"Ravi\",\n  \"lastName\": \"Shankar\",\n  \"role\": \"STAFF\",\n  \"permissions\": [\"student.read\", \"student.create\"]\n}"
            },
            "url": "{{baseUrl}}/api/v1/users"
          }
        }
      ]
    },
    {
      "name": "Students (Reference Business Module)",
      "item": [
        {
          "name": "1. List Students (Tenant Scoped)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/students?page=1&limit=10"
          }
        },
        {
          "name": "2. Create Student",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rollNumber\": \"STU-1001\",\n  \"firstName\": \"Arun\",\n  \"lastName\": \"Kumar\",\n  \"email\": \"arun.k@school.edu\",\n  \"grade\": \"10\",\n  \"section\": \"A\",\n  \"gender\": \"male\",\n  \"status\": \"active\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/students"
          }
        },
        {
          "name": "3. Bulk Import Students",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"students\": [\n    {\n      \"rollNumber\": \"STU-2001\",\n      \"firstName\": \"Priya\",\n      \"lastName\": \"Ramesh\",\n      \"email\": \"priya.r@school.edu\",\n      \"grade\": \"11\",\n      \"section\": \"B\",\n      \"gender\": \"female\"\n    },\n    {\n      \"rollNumber\": \"STU-2002\",\n      \"firstName\": \"Karthik\",\n      \"lastName\": \"S\",\n      \"email\": \"karthik.s@school.edu\",\n      \"grade\": \"11\",\n      \"section\": \"B\",\n      \"gender\": \"male\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/students/import"
          }
        }
      ]
    }
  ]
}
